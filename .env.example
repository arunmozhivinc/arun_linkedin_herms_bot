# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# MongoDB Atlas Free (M0 Cluster)
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/linkedin_hermes?retryWrites=true&w=majority
MONGODB_URI=

# Telegram Bot (created via @BotFather)
TELEGRAM_BOT_TOKEN=

# LinkedIn SaaS Master App (created once by you at developer.linkedin.com)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Optional: Fal.ai API key for Face-Reference Photo Generation (~$0.01/image)
# Leave blank to use 100% free Pollinations.ai Flux generation by default
FAL_KEY=

# Primary Image Generator: HuggingFace Inference API (uses editorial 7-layer brand rules)
# Falls back to Pollinations.ai automatically if not configured or rate-limited
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=black-forest-labs/FLUX.1-dev

# DeepSeek LLM for Hermes Content Engine (OpenAI-compatible)
DEEPSEEK_API_KEY=

# Google Gemini / Imagen 3 for High-Definition Editorial Visuals (from aistudio.google.com)
GEMINI_API_KEY=

